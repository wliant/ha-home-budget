<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Import Spring Boot defaults -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console appender with Logstash JSON encoder -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Application metadata -->
            <customFields>{"application_name":"homebudget-backend","environment":"${SPRING_PROFILES_ACTIVE:-default}"}</customFields>

            <!-- Include MDC fields (correlation_id, user_id) -->
            <includeMdcKeyName>correlation_id</includeMdcKeyName>
            <includeMdcKeyName>user_id</includeMdcKeyName>

            <!-- ISO-8601 timestamp with timezone -->
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
            <timeZone>UTC</timeZone>

            <!-- Include stack trace for exceptions -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>8192</maxLength>
                <shortenedClassNameLength>36</shortenedClassNameLength>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- Async appender with bounded queue -->
    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE_JSON"/>
        <queueSize>10000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- Root logger configuration -->
    <root level="INFO">
        <appender-ref ref="ASYNC_JSON"/>
    </root>

    <!-- Package-specific log levels (can be overridden via application.properties) -->
    <logger name="com.homebudget" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_JSON"/>
    </logger>

    <!-- Reduce noise from Spring Boot internals -->
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="liquibase" level="INFO"/>

</configuration>
