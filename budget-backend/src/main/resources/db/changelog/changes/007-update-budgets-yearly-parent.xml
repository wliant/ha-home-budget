<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-1" author="codex">
        <comment>Allow yearly budgets by making month nullable</comment>
        <dropNotNullConstraint tableName="budgets" columnName="month" columnDataType="INT"/>
    </changeSet>

    <changeSet id="007-2" author="codex">
        <comment>Remove global year/month uniqueness (budgets are per-category)</comment>
        <dropUniqueConstraint tableName="budgets" constraintName="uk_budgets_year_month"/>
    </changeSet>

</databaseChangeLog>
