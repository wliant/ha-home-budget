# MySQL Configuration (required)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=homebudget
MYSQL_USER=budget_user
MYSQL_PASSWORD=change_me_password

# Optional: nginx host port (for direct access via app host's nginx)
NGINX_PORT=80

# HA Add-on Configuration Reference
# -----------------------------------
# The HA add-on (ha-apps-proxy) connects directly to the frontend and backend
# services on this host. Configure the add-on with:
#   server_host: <this host's IP or hostname, e.g., 192.168.1.100>
#   frontend_port: 3000  (matches the frontend service port below)
#   backend_port: 8080   (matches the backend service port below)
#
# The docker-compose.prod.yml exposes:
#   - Frontend on port 3000
#   - Backend on port 8080
# These ports must match the HA add-on's frontend_port and backend_port settings.
